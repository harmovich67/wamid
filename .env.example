# SQLite database file (relative to prisma/)
DATABASE_URL="file:./dev.db"
# Long random string used to sign session tokens: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=""
# Google Gemini API key (can also be set from Admin → AI Assistant)
GEMINI_API_KEY=""
# Passwords used by `npm run db:seed`
SEED_ADMIN_PASSWORD="Wameed@2026"
SEED_STUDENT_PASSWORD="spark123"
# Browser push notifications (Web Push). Generate a pair with: npm run push:keys
# Without them, notifications still appear while the site is open in a tab.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"
